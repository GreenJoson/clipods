{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipods",
  "version": "0.2.0",
  "identifier": "com.evalove.clipods",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "clipods",
        "width": 1080,
        "height": 720,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "clipods"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": null,
    "fs": null,
    "dialog": null,
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMjNBQkY0RjlBRUVDRTYKUldUbTdLNzU5S3Nqd3JxWTdWYytVM1BxSUhEb0gxZHpFdFF0dlVjSDNoQ2pVY0YwYWlqaUNPRFEK",
      "endpoints": [
        "https://github.com/GreenJoson/clipods/releases/latest/download/latest.json"
      ]
    }
  }
}
